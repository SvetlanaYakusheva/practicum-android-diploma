<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/default_padding"
    android:paddingVertical="@dimen/dimen_9dp">

    <com.makeramen.roundedimageview.RoundedImageView
        android:id="@+id/employer_logo"
        android:layout_width="@dimen/vacancy_logo_size"
        android:layout_height="@dimen/vacancy_logo_size"
        android:scaleType="centerCrop"
        app:riv_corner_radius="@dimen/dimen_12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_employer_logo_placeholder_48" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/vacancy_name"
        style="@style/FontDisplay.Medium22"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/employer_logo"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Разработчик на С++ в команду внутренних сервисов, Москва" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/employer_name"
        style="@style/FontDisplay.Regular16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/employer_logo"
        app:layout_constraintTop_toBottomOf="@id/vacancy_name"
        tools:text="Авто.ру" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/vacancy_salary"
        style="@style/FontDisplay.Regular16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dimen_12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/employer_logo"
        app:layout_constraintTop_toBottomOf="@id/employer_name"
        tools:text="от 1 000 до 1 500 €" />


</androidx.constraintlayout.widget.ConstraintLayout>
