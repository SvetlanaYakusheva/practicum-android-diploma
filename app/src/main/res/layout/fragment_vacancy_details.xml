<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:layout_marginTop="@dimen/dimen_8dp"
    android:background="?attr/background_color"
    tools:context=".ui.vacancy.VacancyDetailsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/vacancy_title"
        style="@style/ToolbarStyleParent.AppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/top_app_bar"
            style="@style/ToolbarStyleParent.ToolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:navigationIcon="@drawable/arrow_back_icon"
            app:title="@string/vacancy_title">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/favorites_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/favorites_icon" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/share_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/dimen_4dp"
                android:src="@drawable/share_icon" />

        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/vacancy_details_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dimen_24dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/dimen_16dp"
        android:paddingBottom="@dimen/dimen_16dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vacancy_title">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dimen_8dp"
            android:layout_marginBottom="@dimen/dimen_24dp">

            <TextView
                android:id="@+id/vacancy_name"
                style="@style/FontDisplay.Bold32"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="@string/vacancy_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/salary"
                style="@style/FontDisplay.Medium22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4dp"
                tools:text="@string/vacancy_salary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vacancy_name" />

            <View
                android:id="@+id/company_card"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:background="@drawable/rounded_rectangle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/salary" />

            <ImageView
                android:id="@+id/company_logo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginVertical="@dimen/dimen_16dp"
                android:layout_marginStart="@dimen/dimen_16dp"
                android:contentDescription="@string/company_logo"
                android:src="@drawable/ic_employer_logo_placeholder_48"
                app:layout_constraintBottom_toBottomOf="@id/company_card"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintStart_toStartOf="@id/company_card"
                app:layout_constraintTop_toTopOf="@id/company_card" />

            <TextView
                android:id="@+id/company_name"
                style="@style/FontDisplay.Medium22"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_8dp"
                tools:text="@string/company_name"
                android:textColor="@color/black_universal"
                app:layout_constraintBottom_toTopOf="@id/company_address"
                app:layout_constraintEnd_toEndOf="@id/company_card"
                app:layout_constraintStart_toEndOf="@id/company_logo"
                app:layout_constraintTop_toTopOf="@id/company_logo" />

            <TextView
                android:id="@+id/company_address"
                style="@style/FontDisplay.Regular16"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_8dp"
                tools:text="@string/company_address"
                android:textColor="@color/black_universal"
                app:layout_constraintBottom_toBottomOf="@id/company_logo"
                app:layout_constraintEnd_toEndOf="@id/company_card"
                app:layout_constraintStart_toEndOf="@id/company_logo"
                app:layout_constraintTop_toBottomOf="@id/company_name" />

            <TextView
                android:id="@+id/experience_title"
                style="@style/FontDisplay.Medium16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:text="@string/experience"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/company_card" />

            <TextView
                android:id="@+id/experience"
                style="@style/FontDisplay.Regular16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4dp"
                tools:text="@string/experience_value"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/experience_title" />

            <TextView
                android:id="@+id/schedule"
                style="@style/FontDisplay.Regular16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_8dp"
                android:text="@string/schedule"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/experience" />

            <TextView
                android:id="@+id/vacancy_description_title"
                style="@style/FontDisplay.Medium22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_32dp"
                android:text="@string/vacancy_description"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/schedule" />

            <TextView
                android:id="@+id/vacancy_description"
                style="@style/FontDisplay.Regular16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vacancy_description_title"
                tools:text="@string/responsibilities_example" />

            <TextView
                android:id="@+id/skills_title"
                style="@style/FontDisplay.Medium22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:text="@string/skills_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/vacancy_description"
                app:layout_constraintBottom_toTopOf="@id/skills_list"/>

            <TextView
                android:id="@+id/skills_list"
                style="@style/FontDisplay.Regular16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/skills_list"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/skills_title"
                app:layout_constraintBottom_toTopOf="@id/contacts_title"/>

            <TextView
                android:id="@+id/contacts_title"
                style="@style/FontDisplay.Medium22"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_24dp"
                android:text="@string/contacts_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/skills_list" />

            <TextView
                android:id="@+id/email_title"
                style="@style/FontDisplay.Regular16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4dp"
                android:text="@string/email"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/contacts_title" />

            <TextView
                android:id="@+id/email"
                style="@style/FontDisplay.Regular16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_8dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                app:layout_constraintStart_toEndOf="@id/email_title"
                app:layout_constraintTop_toBottomOf="@id/contacts_title"
                tools:text="@string/email" />

            <TextView
                android:id="@+id/phone_title"
                style="@style/FontDisplay.Regular16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dimen_4dp"
                android:text="@string/phone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/email_title" />

            <TextView
                android:id="@+id/phone"
                style="@style/FontDisplay.Regular16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dimen_8dp"
                android:layout_marginTop="@dimen/dimen_4dp"
                app:layout_constraintStart_toEndOf="@id/phone_title"
                app:layout_constraintTop_toBottomOf="@id/email_title"
                tools:text="@string/phone" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/notFoundPlaceholder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/notfound2_icon"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/not_found_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vacancy_title"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/not_found_text"
        style="@style/FontDisplay.Medium22"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimen_16dp"
        android:gravity="center_horizontal"
        android:text="@string/vacancy_not_found"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/notFoundPlaceholder" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:layout_marginBottom="56dp"
        android:indeterminateTint="@color/blue"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vacancy_title" />

</androidx.constraintlayout.widget.ConstraintLayout>
